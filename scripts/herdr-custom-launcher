#!/bin/bash
# Install ahead of the official Herdr in PATH; never overwrite the official binary.
set -euo pipefail

checkout="${HERDR_CUSTOM_CHECKOUT:-$HOME/herdr-upload-client}"
store="${HERDR_CUSTOM_STORE:-$HOME/.local/share/herdr-custom}"
active="$store/herdr"

if [[ "${1:-}" != update ]]; then
    if [[ ! -x "$active" ]]; then
        echo "Custom Herdr is not installed at $active; the official binary is unchanged." >&2
        exit 1
    fi
    exec "$active" "$@"
fi
shift
if (( $# != 0 )); then
    echo 'Custom herdr update does not support extra arguments (including --handoff).' >&2
    exit 2
fi
if [[ ! -x "$active" ]]; then
    echo "Custom Herdr is not installed at $active; install the tested binary first." >&2
    exit 1
fi
if [[ ! -d "$checkout/.git" ]]; then
    echo "Missing source checkout: $checkout" >&2
    exit 1
fi
origin="$(git -C "$checkout" remote get-url origin)"
case "$origin" in
    https://github.com/jekozyra/herdr|https://github.com/jekozyra/herdr.git|git@github.com:jekozyra/herdr|git@github.com:jekozyra/herdr.git) ;;
    *) echo "Refusing to update from unexpected origin: $origin" >&2; exit 1 ;;
esac
if [[ "$(git -C "$checkout" branch --show-current)" != master ]]; then
    echo 'Switch the custom source checkout to master before updating.' >&2
    exit 1
fi
if [[ -n "$(git -C "$checkout" status --porcelain)" ]]; then
    echo 'Custom source checkout has uncommitted changes; refusing to update.' >&2
    exit 1
fi
if ! mkdir "$store/.update-lock" 2>/dev/null; then
    echo 'Another custom Herdr update is running (or its lock needs manual inspection).' >&2
    exit 1
fi
stage="$store/.herdr-new-$$"
backup_stage="$store/.herdr-backup-$$"
revision_stage="$store/.revision-new-$$"
cleanup() {
    rm -f "$stage" "$backup_stage" "$revision_stage"
    rmdir "$store/.update-lock"
}
trap cleanup EXIT

# Only the fork's reviewed master is installed. Never reset to upstream or run
# the official self-updater, which would replace this custom build.
git -C "$checkout" fetch origin master
if ! git -C "$checkout" merge-base --is-ancestor HEAD origin/master; then
    echo 'Source checkout diverged from the fork; resolve it manually.' >&2
    exit 1
fi
git -C "$checkout" merge --ff-only origin/master
revision="$(git -C "$checkout" rev-parse HEAD)"
if [[ -f "$store/installed-revision" ]] && [[ "$(<"$store/installed-revision")" == "$revision" ]]; then
    echo "Custom Herdr is already up to date ($revision)."
    exit 0
fi

if [[ -z "${ZIG:-}" ]] && ! command -v zig >/dev/null 2>&1; then
    for candidate in "$HOME/.local/opt/zig-aarch64-macos-0.16.0/zig" "$HOME/.local/opt/zig-x86_64-macos-0.16.0/zig"; do
        if [[ -x "$candidate" ]]; then
            export ZIG="$candidate"
            break
        fi
    done
fi
if [[ -n "${ZIG:-}" ]]; then
    zig_version="$("$ZIG" version)"
else
    zig_version="$(zig version)"
fi
if [[ "$zig_version" != 0.16.0 ]]; then
    echo "This checkout requires Zig 0.16.0, found $zig_version" >&2
    exit 1
fi

(cd "$checkout" && python3 -m unittest scripts.test_file_upload_receiver scripts.test_select_upstream_release)
(cd "$checkout" && cargo test --locked --bin herdr file_upload)
(cd "$checkout" && cargo build --release --locked)
cp "$checkout/target/release/herdr" "$stage"
chmod 755 "$stage"
"$stage" --version

# The active binary remains untouched if fetch, tests, or build fail.
cp "$active" "$backup_stage"
mv -f "$backup_stage" "$store/herdr.previous"
if [[ -f "$store/installed-revision" ]]; then
    cp "$store/installed-revision" "$revision_stage"
    mv -f "$revision_stage" "$store/previous-revision"
fi
mv -f "$stage" "$active"
printf '%s\n' "$revision" > "$revision_stage"
mv -f "$revision_stage" "$store/installed-revision"
echo "Installed custom Herdr from $revision. Previous custom binary: $store/herdr.previous"
echo 'Check Finder drops and clipboard-image paste before relying on this version.'
